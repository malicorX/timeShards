# AI TimeShards — copy to .env or set in PowerShell before `npm run api` / Tauri dev.
# Do not commit real secrets.

# SQLite database path (default: ./.data/timeshards-api.db)
# TIMESHARDS_DB=M:\Data\Projects\ai_timeshards\.data\timeshards-api.db

# API bind (default 127.0.0.1:47821)
# TIMESHARDS_API_HOST=127.0.0.1
# TIMESHARDS_API_PORT=47821

# Production / staging
# TIMESHARDS_DISABLE_DEMO=1
# TIMESHARDS_BLOCK_DEFAULT_PASSWORDS=1
# TIMESHARDS_ADMIN_PASSWORD=change-me-on-first-deploy

# Hardware: sim (default) or external / primion (typos fall back to sim; see health.hardware_adapter_configured)
# TIMESHARDS_HW_ADAPTER=sim
# TIMESHARDS_HW_ADAPTER=external
# TIMESHARDS_HW_TCP_ADDR=127.0.0.1:47831
